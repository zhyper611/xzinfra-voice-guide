GUIDE_XZKB_BASE_URL=https://knowledge.example.invalid
GUIDE_XZKB_API_KEY=replace-with-xzkb-api-key
GUIDE_XZKB_EMPTY_SEARCH_RESPONSE=知识库中无相关内容，请尝试提问其他问题。

GUIDE_FAQ_CACHE_ENABLED=true
GUIDE_FAQ_CACHE_FILE=config/faq_cache.yaml
GUIDE_FAQ_PREPARED_AUDIO_ENABLED=true

GUIDE_ASR_BASE_URL=https://speech.example.invalid/v1
GUIDE_ASR_API_KEY=replace-with-asr-api-key
GUIDE_ASR_MODEL=replace-with-asr-model

GUIDE_TTS_BASE_URL=https://speech.example.invalid/v1
GUIDE_TTS_API_KEY=replace-with-tts-api-key
GUIDE_TTS_MODEL=replace-with-tts-model
GUIDE_TTS_VOICE=alloy
GUIDE_TTS_SPEED=1.0

GUIDE_DEVICE_API_KEY=replace-with-random-device-key
GUIDE_DEVICE_MAX_UPLOAD_BYTES=10485760
GUIDE_LOCAL_RECORDING_MAX_SECONDS=60
GUIDE_LOCAL_RECORDING_MIN_SECONDS=0.5
GUIDE_LOCAL_RECORDING_MIN_DBFS=-45

GUIDE_REQUEST_TIMEOUT_SECONDS=30
GUIDE_FIRST_AUDIO_TIMEOUT_SECONDS=5
GUIDE_PLAYBACK_TIMEOUT_SECONDS=300
GUIDE_SESSION_IDLE_SECONDS=1800
GUIDE_SESSION_CLEANUP_SECONDS=60
GUIDE_MAX_ACTIVE_SESSIONS=100
GUIDE_XZKB_CONCURRENCY=4
GUIDE_TTS_CONCURRENCY=2
GUIDE_QUEUE_TIMEOUT_SECONDS=120
GUIDE_AUDIO_TTL_SECONDS=600
GUIDE_AUDIO_ITEMS_PER_SESSION=3

GUIDE_CAPTURE_DEVICE=default
GUIDE_PLAYBACK_DEVICE=default
GUIDE_SAMPLE_RATE=16000
GUIDE_GPIO_BUTTON_ENABLED=false
GUIDE_BUTTON_HOLD_SECONDS=1.5
GUIDE_KNOWLEDGE_CAPTURE_ENABLED=false
# GUIDE_XZKB_WRITE_TOKEN=replace-with-xzkb-user-token
# GUIDE_XZKB_KNOWLEDGE_BASE_ID=replace-with-knowledge-base-uuid
# GUIDE_XZKB_KNOWLEDGE_FOLDER_ID=replace-with-folder-uuid
GUIDE_KNOWLEDGE_OUTBOX_PATH=~/.local/share/showroom-guide/knowledge-outbox.sqlite3
GUIDE_KNOWLEDGE_SYNC_INTERVAL_SECONDS=30
GUIDE_PTT_PIN=17
GUIDE_STOP_PIN=27
GUIDE_VOLUME_UP_PIN=22
GUIDE_VOLUME_DOWN_PIN=23
GUIDE_SCRIPTS_FILE=/var/lib/showroom-guide/scripts.yaml
GUIDE_AUDIO_CACHE_DIR=/var/lib/showroom-guide/audio
GUIDE_RUNTIME_DIR=/run/showroom-guide
