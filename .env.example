GUIDE_AUDIO_TTL_SECONDS=600
GUIDE_AUDIO_ITEMS_PER_SESSION=3

GUIDE_CAPTURE_DEVICE=default
GUIDE_PLAYBACK_DEVICE=default
GUIDE_SAMPLE_RATE=16000
GUIDE_GPIO_BUTTON_ENABLED=false
